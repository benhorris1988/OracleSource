# Copy to .env in this directory before `docker compose up`. The defaults
# match config/source.json so out-of-the-box the Flutter app, the Oracle
# container, and external consumers all agree on the same credentials.
#
# Change APP_USER / APP_USER_PASSWORD here AND in config/source.json (or
# via Source settings → "Copy config/source.json") so the two stay in sync.

# SYS / SYSTEM admin password. Only used when Oracle first provisions the
# database — change before that first start if you care.
ORACLE_SYS_PASSWORD=oracle_admin_password

# Pluggable database name that becomes the Oracle service consumers connect
# to (e.g. //localhost:1521/IFSPRD).
ORACLE_PDB=IFSPRD

# Application user that owns IFSAPP tables. Consumers authenticate as this.
APP_USER=IFSAPP
APP_USER_PASSWORD=ifs_dev_password
